{
  "name": "ab-webui",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "prepare": "cd .. && husky webui/.husky",
    "test:build": "vue-tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-desktop",
    "test:e2e:webkit": "playwright test --project=webkit-mobile",
    "test:e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-inline-svg": "^3.1.4",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.0",
    "@autobangumi/plugin-ui": "workspace:*",
    "@icon-park/vue-next": "^1.4.2",
    "@iconify-json/simple-icons": "1.2.89",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@types/node": "^24",
    "@unocss/preset-rem-to-px": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.0.0",
    "eslint-plugin-storybook": "^10.6.2",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "sass-embedded": "^1.105.2",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
